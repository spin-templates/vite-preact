{{ if .include_demo }}import { ThemeSwitcher } from './ThemeSwitcher.tsx'
{{ end }}import { site } from './site.ts'
import './app.css'

{{ if .include_demo }}const framework = 'Preact'
{{ end }}
{{ if .include_demo }}
