function RegistryIcon() {
  return (
    <svg className="btn-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" strokeWidth="1.5" aria-hidden="true">
      <rect x="2" y="2" width="5.2" height="5.2" rx="1.4" />
      <rect x="8.8" y="2" width="5.2" height="5.2" rx="1.4" />
      <rect x="2" y="8.8" width="5.2" height="5.2" rx="1.4" />
      <rect x="8.8" y="8.8" width="5.2" height="5.2" rx="1.4" />
    </svg>
  )
}

const community = [
  { label: 'GitHub', href: site.github },
  { label: 'Discord', href: 'https://discord.gg/DTGm9MaEKH' },
  { label: 'X', href: 'https://x.com/sam0uly' },
]
{{ end }}

export function App() {
  return (
    {{ if .include_demo }}
    <div className="sheet">
      <span className="corner tl" aria-hidden="true" />
      <span className="corner tr" aria-hidden="true" />
      <span className="corner bl" aria-hidden="true" />
      <span className="corner br" aria-hidden="true" />

      <ThemeSwitcher />

      <div className="content">
        <div className="dim-line">
          <span className="cap" aria-hidden="true" />
          <span className="label">{framework} + Vite</span>
          <span className="rule" aria-hidden="true" />
          <span className="cap" aria-hidden="true" />
        </div>

        <h1>{site.name}</h1>
        <p className="tagline">{site.description}</p>

        <div className="cta-row">
          <a className="btn-primary" href={site.github} target="_blank" rel="noreferrer">
            <GitHubIcon />
            View on GitHub
          </a>
          <a className="btn-secondary" href={site.registry} target="_blank" rel="noreferrer">
            <RegistryIcon />
            Registry
          </a>
        </div>

        <div className="refs">
          <span className="refs-label">Docs</span>
          {site.tools.map((tool, i) => (
            <span className="refs-group" key={tool.label}>
              {i > 0 && <span className="sep" aria-hidden="true">·</span>}
              <a href={tool.href} target="_blank" rel="noreferrer">
                {tool.label}
              </a>
            </span>
          ))}
          <span className="refs-gap" aria-hidden="true" />
          <span className="refs-label">Community</span>
          {community.map((link, i) => (
            <span className="refs-group" key={link.label}>
              {i > 0 && <span className="sep" aria-hidden="true">·</span>}
              <a href={link.href} target="_blank" rel="noreferrer">
                {link.label}
              </a>
            </span>
          ))}
        </div>
      </div>

      <div className="title-block">
        <div className="cell">
          <p className="cell-label">Project</p>
          <p className="cell-value">{site.name}</p>
        </div>
        <div className="cell">
          <p className="cell-label">Stack</p>
          <p className="cell-value">{framework} · Vite</p>
        </div>
        <div className="cell">
          <p className="cell-label">Scaffold</p>
          <p className="cell-value">Spin</p>
        </div>
        <div className="cell">
          <p className="cell-label">License</p>
          <p className="cell-value">MIT</p>
        </div>
      </div>
    </div>
    {{ else }}
    <div className="blank">
      <span className="blank-name">{site.name}</span>
      <span className="blank-line">Scaffolded with Spin</span>
    </div>
    {{ end }}
  )
}